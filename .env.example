# Copy to .env.local and use values from your Supabase project's Connect dialog.
# Use the public anon key (or publishable key), never a service-role/secret key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only AI credentials. Get a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
